[Unit]
Description=Propraetor example web-api-with-db private DB sidecar

[Container]
Image=docker.io/library/postgres:18-alpine
ContainerName=web-api-with-db-db
Pod=web-api-with-db.pod
Environment=POSTGRES_USER=app
Environment=POSTGRES_PASSWORD=example
Environment=POSTGRES_DB=app
Environment=PGDATA=/var/lib/workload/pgdata
Volume=../persist:/var/lib/workload:U

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
