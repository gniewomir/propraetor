[Unit]
Description=Propraetor example env-config app

[Container]
Image=docker.io/library/busybox:latest
ContainerName=env-config-app
Pod=env-config.pod
Exec=sleep infinity
Volume=/host-volume/workloads/env-config/persist:/var/lib/workload:rw

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
