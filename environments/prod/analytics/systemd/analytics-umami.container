[Unit]
Description=Umami web analytics

[Container]
Image=ghcr.io/umami-software/umami:3.4.0
ContainerName=analytics-umami
Pod=analytics.pod
# Umami image USER is nextjs (1001); Platform Database client.key is 0600 for
# platform — stay UID 0 inside the user namespace so Prisma can read mTLS material.
User=0
Volume=../scripts/entrypoint.sh:/opt/platform/entrypoint.sh:ro
Volume=../persist:/var/lib/workload:rw
Entrypoint=/bin/sh
Exec=/opt/platform/entrypoint.sh
Environment=DISABLE_TELEMETRY=1
Environment=CLIENT_IP_HEADER=X-Real-IP

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
