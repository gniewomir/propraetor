[Unit]
Description=Propraetor panel

[Container]
Image=docker.io/library/nginx:1.31.3-alpine
ContainerName=panel-web
Pod=panel.pod
Volume=../www:/usr/share/nginx/html:ro
Volume=../persist:/var/lib/workload:rw
Volume=../persist/stats:/usr/share/nginx/html/stats:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
