[Unit]
Description=Propraetor welcome page

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=welcome-web
Pod=welcome.pod
Volume=/var/lib/host-volume/internals/workloads/welcome/www:/usr/share/nginx/html:ro
Volume=/var/lib/host-volume/data/workloads/welcome:/var/lib/workload:rw
Volume=/var/lib/host-volume/data/workloads/welcome/stats:/usr/share/nginx/html/stats:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
