# Provider Credential + Operator Configuration baseline (ADR-0038).
# Copy to `.env` (gitignored). Non-empty process-environment values override this file.
# Paths must be absolute or ~/…

DIGITALOCEAN_TOKEN=

PROPRAETOR_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
PROPRAETOR_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# Required when environments/<slug>/acme.json is present (ADR-0045).
PROPRAETOR_ACME_EMAIL=

# Optional: relocate Environments root (directory of <slug>/ trees). Absolute or ~/…
# When set, fully replaces repo environments/ for tooling (ADR-0051).
# PROPRAETOR_ENVIRONMENTS_ROOT=
