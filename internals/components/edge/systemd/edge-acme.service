[Unit]
Description=Propraetor Edge ACME (on-demand)
After=edge-pod.service

[Service]
Type=oneshot
# lego per-name bound wait is 120s; allow multi-name want-lists + Edge reload.
TimeoutStartSec=900
# Environment ACME config staged by ensure-components (ADR-0045).
EnvironmentFile=/host-volume/components/edge/persist/acme/environment
ExecStart=/host-volume/components/edge/acme-run.sh

[Install]
WantedBy=default.target
