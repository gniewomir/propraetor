[Unit]
Description=Propraetor Database PostgreSQL
After=network-online.target

[Container]
Image=docker.io/library/postgres:18-alpine
ContainerName=database-postgres
Pod=database.pod
EnvironmentFile=/host-volume/components/database/persist/admin/environment
Environment=PGDATA=/var/lib/postgresql/data/pgdata
Entrypoint=/usr/local/bin/database-entrypoint.sh
Volume=../entrypoint.sh:/usr/local/bin/database-entrypoint.sh:ro
Volume=../persist/pgdata:/var/lib/postgresql/data:U
Volume=../persist/ca/ca.crt:/etc/database-certs/ca.crt:ro
Volume=../persist/server/server.crt:/etc/database-certs/server.crt:ro
Volume=../persist/server/server.key:/etc/database-certs/server.key:ro
Volume=../persist/conf:/etc/database-conf:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
